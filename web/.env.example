# ==========================================
# SkillBridge Web - Ortam Değişkenleri Şablonu
# Bu dosyayı .env.local olarak kopyalayın ve değerlerinizi girin:
# cp .env.example .env.local
# ==========================================

# Groq Cloud API Anahtarı (Sunucu tarafında güvenle kullanılır, istemciye sızdırılmaz)
# https://console.groq.com/keys adresinden ücretsiz alabilirsiniz.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Supabase Veritabanı ve Kimlik Doğrulama Bilgileri
# https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
