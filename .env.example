# ==========================================
# SkillBridge - Genel Ortam Değişkenleri Şablonu
# ==========================================

# 1) WEB UYGULAMASI (web/.env.local içine ekleyin)
# ----------------------------------------------------
# Groq API Key (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Supabase API (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here


# 2) MOBİL UYGULAMA (mobile/.env içine ekleyin)
# ----------------------------------------------------
EXPO_PUBLIC_GROQ_API_KEY=gsk_your_groq_api_key_here
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
